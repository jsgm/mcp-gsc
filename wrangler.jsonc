{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Change the name to deploy another instance (e.g. "mcp-gsc-personal").
  "name": "mcp-gsc",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Each MCP session runs in a Durable Object (required by McpAgent).
  "durable_objects": {
    "bindings": [{ "class_name": "GscMCP", "name": "MCP_OBJECT" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GscMCP"] }],

  // OAuth tokens, registered clients and login state.
  // No "id": the KV namespace is provisioned automatically on the first deploy
  // (Deploy to Cloudflare button or `wrangler deploy`), and its id is filled in.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],

  "observability": { "enabled": true }

  // Secrets (listed in .dev.vars.example; the Deploy button asks for them,
  // or set them with `npx wrangler secret put NAME`):
  //   GSC_SERVICE_ACCOUNT_JSON  - full JSON key of the Google service account
  //   CF_ACCESS_CLIENT_ID          - Cloudflare Access for SaaS (OIDC) client ID
  //   CF_ACCESS_CLIENT_SECRET      - Cloudflare Access for SaaS (OIDC) client secret
  //   CF_ACCESS_AUTHORIZATION_URL  - .../cdn-cgi/access/sso/oidc/<client_id>/authorization
  //   CF_ACCESS_TOKEN_URL          - .../cdn-cgi/access/sso/oidc/<client_id>/token
  //   CF_ACCESS_JWKS_URL           - .../cdn-cgi/access/sso/oidc/<client_id>/jwks
  //
  // Optional: ALLOWED_EMAILS (comma-separated) as an extra allowlist on top of
  // the Cloudflare Access policy. Add it as a variable or secret if you want it.
}
