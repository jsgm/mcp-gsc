# Copy to .dev.vars for local development with `npm run dev`.
# For local testing, add http://localhost:8787/callback as a redirect URL
# in your Cloudflare Access for SaaS application.

# Service account JSON on a single line.
GSC_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

ACCESS_CLIENT_ID=""
ACCESS_CLIENT_SECRET=""
ACCESS_AUTHORIZATION_URL="https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/authorization"
ACCESS_TOKEN_URL="https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/token"
ACCESS_JWKS_URL="https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/jwks"
